<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header Title -->
        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-Reply Pending"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtitle - Recipient -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reviewing response to"
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_header_title" />

        <TextView
            android:id="@+id/tv_recipient_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sarah Jenkins"
            android:textSize="16sp"
            android:textColor="#212121"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/tv_subtitle"
            app:layout_constraintTop_toTopOf="@id/tv_subtitle"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_subtitle" />

        <!-- Main Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Timer Section with Thumbs Up/Down -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Timer Icon and Text -->
                    <ImageView
                        android:id="@+id/iv_timer_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_lock_idle_alarm"
                        app:tint="#2196F3" />

                    <TextView
                        android:id="@+id/tv_timer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sending in 3:34"
                        android:textSize="18sp"
                        android:textColor="#2196F3"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp" />

                    <!-- Thumbs Up Button -->
                    <ImageButton
                        android:id="@+id/btn_thumbs_up"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_thumbs_up"
                        android:contentDescription="Thumbs up"
                        app:tint="#757575"
                        android:scaleType="fitCenter"
                        android:padding="10dp" />

                    <!-- Thumbs Down Button -->
                    <ImageButton
                        android:id="@+id/btn_thumbs_down"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_thumbs_down"
                        android:contentDescription="Thumbs down"
                        app:tint="#757575"
                        android:scaleType="fitCenter"
                        android:padding="10dp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <!-- Context Detected Section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_context"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FAFBFC"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Context Header with Expand/Collapse -->
                        <LinearLayout
                            android:id="@+id/layout_context_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Context Detected"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#212121" />

                            <ImageView
                                android:id="@+id/iv_expand_collapse"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/arrow_up_float"
                                app:tint="#757575" />
                        </LinearLayout>

                        <!-- Context Description (Collapsible) -->
                        <LinearLayout
                            android:id="@+id/layout_context_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Adjust tags if the situation was misjudged. This helps improve future suggestions."
                                android:textSize="13sp"
                                android:textColor="#757575"
                                android:lineSpacingExtra="2dp" />

                            <!-- Context Tags Container -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="12dp">

                                <!-- Activity Tag -->
                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_activity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Activity: In a meeting"
                                    android:textColor="#1976D2"
                                    app:chipBackgroundColor="#E3F2FD"
                                    app:chipIcon="@android:drawable/ic_menu_my_calendar"
                                    app:chipIconTint="#1976D2"
                                    app:closeIconVisible="true"
                                    app:closeIconTint="#1976D2"
                                    android:layout_marginBottom="8dp" />

                                <!-- Sender Tag -->
                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_sender"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sender: Manager"
                                    android:textColor="#1976D2"
                                    app:chipBackgroundColor="#E3F2FD"
                                    app:chipIcon="@android:drawable/ic_menu_myplaces"
                                    app:chipIconTint="#1976D2"
                                    app:closeIconVisible="true"
                                    app:closeIconTint="#1976D2"
                                    android:layout_marginBottom="8dp" />

                                <!-- Urgency Tag -->
                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_urgency"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Urgency: Normal"
                                    android:textColor="#1976D2"
                                    app:chipBackgroundColor="#E3F2FD"
                                    app:chipIcon="@android:drawable/ic_menu_info_details"
                                    app:chipIconTint="#1976D2"
                                    app:closeIconVisible="true"
                                    app:closeIconTint="#1976D2"
                                    android:layout_marginBottom="8dp" />

                                <!-- Add Tag Button -->
                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_add"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+ Add"
                                    android:textColor="#757575"
                                    app:chipBackgroundColor="@android:color/transparent"
                                    app:chipStrokeWidth="1dp"
                                    app:chipStrokeColor="#BDBDBD"
                                    style="@style/Widget.MaterialComponents.Chip.Action" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Message Preview Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FAFBFC"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_message_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hi Sarah, I'm currently in a design sync until 3 PM and unable to review the deck right now. I'll take a look as soon as I'm out."
                            android:textSize="15sp"
                            android:textColor="#212121"
                            android:lineSpacingExtra="4dp" />

                        <!-- Editable Label -->
                        <TextView
                            android:id="@+id/tv_editable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EDIT"
                            android:textSize="12sp"
                            android:textColor="#2196F3"
                            android:textStyle="bold"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:padding="8dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="80dp"
            app:layout_constraintTop_toBottomOf="@id/card_main"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Cancel Send Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Cancel Send"
                android:textSize="16sp"
                android:textColor="#757575"
                app:cornerRadius="12dp"
                app:strokeWidth="2dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginEnd="8dp" />

            <!-- Send Now Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_now"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Send Now"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_send"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#2196F3"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            app:menu="@menu/bottom_navigation_menu"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@color/bottom_nav_color"
            app:itemTextColor="@color/bottom_nav_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>