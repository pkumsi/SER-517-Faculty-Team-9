<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Review Auto-Response"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_close" />

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Close"
        app:layout_constraintTop_toTopOf="@id/tv_dialog_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#757575" />

    <!-- Divider -->
    <View
        android:id="@+id/divider_title"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="400dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider_feedback">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Recipient Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F5F7FA"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Recipient Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="To: "
                            android:textSize="14sp"
                            android:textColor="#757575" />

                        <TextView
                            android:id="@+id/tv_recipient_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sarah Jenkins"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            tools:text="Sarah Jenkins" />

                    </LinearLayout>

                    <!-- Timestamp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sent: "
                            android:textSize="14sp"
                            android:textColor="#757575" />

                        <TextView
                            android:id="@+id/tv_timestamp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Today, 2:45 PM"
                            android:textSize="14sp"
                            android:textColor="#616161"
                            tools:text="Today, 2:45 PM" />

                    </LinearLayout>

                    <!-- Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: "
                            android:textSize="14sp"
                            android:textColor="#757575" />

                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sent Successfully"
                            android:textSize="14sp"
                            android:textColor="#4CAF50"
                            android:textStyle="bold"
                            tools:text="Sent Successfully" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Message Content Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Message Sent:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FAFBFC"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0">

                <TextView
                    android:id="@+id/tv_message_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hi Sarah, I'm currently in a design sync until 3 PM and unable to review the deck right now. I'll take a look as soon as I'm out."
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    tools:text="Hi Sarah, I'm currently in a design sync until 3 PM and unable to review the deck right now. I'll take a look as soon as I'm out." />

            </com.google.android.material.card.MaterialCardView>

            <!-- Context Information Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Context Detected:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E3F2FD"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Context Tags -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_context"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_activity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activity: In a meeting"
                            android:textColor="#1976D2"
                            app:chipBackgroundColor="#BBDEFB"
                            app:chipIcon="@android:drawable/ic_menu_my_calendar"
                            app:chipIconTint="#1976D2"
                            android:clickable="false"
                            style="@style/Widget.MaterialComponents.Chip.Entry" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sender: Manager"
                            android:textColor="#1976D2"
                            app:chipBackgroundColor="#BBDEFB"
                            app:chipIcon="@android:drawable/ic_menu_myplaces"
                            app:chipIconTint="#1976D2"
                            android:clickable="false"
                            style="@style/Widget.MaterialComponents.Chip.Entry" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_urgency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Urgency: Normal"
                            android:textColor="#1976D2"
                            app:chipBackgroundColor="#BBDEFB"
                            app:chipIcon="@android:drawable/ic_menu_info_details"
                            app:chipIconTint="#1976D2"
                            android:clickable="false"
                            style="@style/Widget.MaterialComponents.Chip.Entry" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>