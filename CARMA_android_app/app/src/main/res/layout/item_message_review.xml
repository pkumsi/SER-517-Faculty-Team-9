<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Status Indicator (sent/cancelled) -->
        <View
            android:id="@+id/view_status_indicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="#4CAF50"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_status_indicator"
            app:layout_constraintEnd_toStartOf="@id/layout_feedback_indicator">

            <!-- Recipient Name and Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_recipient_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sarah Jenkins"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Sarah Jenkins" />

                <TextView
                    android:id="@+id/tv_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2:45 PM"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginStart="8dp"
                    tools:text="2:45 PM" />

            </LinearLayout>

            <!-- Message Preview -->
            <TextView
                android:id="@+id/tv_message_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hi Sarah, I'm currently in a design sync until 3 PM and unable to review..."
                android:textSize="14sp"
                android:textColor="#616161"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp"
                tools:text="Hi Sarah, I'm currently in a design sync until 3 PM and unable to review the deck right now. I'll take a look as soon as I'm out." />

            <!-- Context Tags Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_context_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In a meeting"
                    android:textSize="10sp"
                    android:textColor="#1976D2"
                    app:chipBackgroundColor="#E3F2FD"
                    app:chipMinHeight="24dp"
                    android:clickable="false"
                    style="@style/Widget.MaterialComponents.Chip.Entry" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_context_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manager"
                    android:textSize="10sp"
                    android:textColor="#1976D2"
                    app:chipBackgroundColor="#E3F2FD"
                    app:chipMinHeight="24dp"
                    android:layout_marginStart="4dp"
                    android:clickable="false"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Chip.Entry" />

                <TextView
                    android:id="@+id/tv_more_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+2 more"
                    android:textSize="10sp"
                    android:textColor="#757575"
                    android:layout_marginStart="4dp"
                    android:gravity="center_vertical"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- Feedback Indicator -->
        <LinearLayout
            android:id="@+id/layout_feedback_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Feedback Icon -->
            <ImageView
                android:id="@+id/iv_feedback_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_thumbs_up"
                android:visibility="gone"
                android:contentDescription="Feedback given"
                app:tint="#4CAF50" />

            <!-- No Feedback Indicator -->
            <TextView
                android:id="@+id/tv_no_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to\nreview"
                android:textSize="10sp"
                android:textColor="#BDBDBD"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>