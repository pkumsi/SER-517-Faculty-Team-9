# Server Configuration
PORT=8080
HOST=localhost
ENVIRONMENT=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# API Configuration
API_VERSION=v1
API_TIMEOUT=30s

# OpenAI Configuration 
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

