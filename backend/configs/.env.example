# Server Configuration
PORT=8080
HOST=localhost
ENVIRONMENT=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# API Configuration
API_VERSION=v1
API_TIMEOUT=30s

# LLM Configuration (Groq — OpenAI-compatible API)
GROQ_API_KEY=your_groq_api_key_here
# Optional override; default is Groq OpenAI-compatible endpoint
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Redis Cache
REDIS_ENABLED=true
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=1h
