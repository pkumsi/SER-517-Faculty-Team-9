# Server Configuration
PORT=8080
HOST=localhost
ENVIRONMENT=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# API Configuration
API_VERSION=v1
API_TIMEOUT=30s

# LLM Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-nano-9b-v2:free
LLM_MAX_TOKENS=1000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Memory Service (in-memory record store)
# Max records retained per user UUID. <= 0 means unlimited.
MEMORY_PER_USER_CAPACITY=100
